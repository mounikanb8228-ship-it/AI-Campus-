# Copy to .env and edit. Never commit .env.
SECRET_KEY=
# Address people open (goes into the QR codes). For a demo on one Wi-Fi use your PC's LAN address.
SITE_URL=http://127.0.0.1:5000
HOST=127.0.0.1
PORT=5000
COOKIE_SECURE=0
TRUST_PROXY=0

# Optional LLM for nicer answers. Leave LLM_PROVIDER=none to answer from the retrieved passages only.
LLM_PROVIDER=none
# anthropic | openai   (openai also works with any OpenAI-compatible service via LLM_BASE_URL)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
